<%- include("../partials/header.ejs") %>

<body>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

  
                <div class="card-header text-center bg-white py-4">

    
                    <h3 class="fw-bold">
                        <%= titulo %>
                    </h3>

                </div>
                <div class="card-body p-4">

                    <form 
                        action="/escuelas" 
                        method="POST" 
                        enctype="multipart/form-data"
                    >

  
                        <div class="mb-3">

                            <label class="form-label">
                                Nombre de la escuela
                            </label>

                            <input 
                                type="text" 
                                name="nombre"
                                class="form-control"
                                placeholder="Ingresá el nombre de tu escuela"
                            >

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Número de padrón
                            </label>

                            <input 
                                type="number" 
                                name="padron"
                                class="form-control"
                                placeholder="Ingresá el número de tu escuela"
                            >

                        </div>


                        <div class="mb-3">

                            <label for="region_id" class="form-label">
                                Región
                            </label>

                            <select 
                                name="region_id" 
                                id="region_id"
                                class="form-select"
                            >

                                <option value="">
                                    Seleccioná una región
                                </option>

                                <% regiones.forEach(region => { %>

                                    <option value="<%= region.id %>">
                                        <%= region.nombre %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Localidad
                            </label>

                            <input 
                                type="text" 
                                name="localidad"
                                class="form-control"
                                placeholder="Ingresá la localidad"
                            >

                        </div>
                        <div class="mb-4">

                            <label class="form-label">
                                Logo de la escuela
                            </label>

                            <input 
                                type="file" 
                                name="logo"
                                class="form-control"
                                accept="image/*"
                            >

                        </div>

                        <button 
                            type="submit"
                            class="btn btn-primary w-100"
                        >
                            Enviar datos
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>